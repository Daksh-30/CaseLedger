{
  "name": "caseledger",
  "version": "1.0.0",
  "private": true,
  "description": "CaseLedger: Blockchain-Based Criminal Case Record Management and Audit System",
  "scripts": {
    "compile":      "npx hardhat compile",
    "test":         "npx hardhat test test/CaseLedgerRegistry.test.ts",
    "node":         "npx hardhat node",
    "deploy":       "npx hardhat run scripts/deploy.ts --network localhost",
    "deploy:seed":  "npx hardhat run scripts/seed.ts --network localhost",
    "remixd":       "remixd -s ./contracts --remix-ide https://remix.ethereum.org"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.11.24",
    "hardhat": "^2.22.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  }
}
